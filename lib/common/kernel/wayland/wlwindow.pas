program wlwindow;
{ Prototype of the MSEgui pure Wayland backend: one xdg toplevel window drawn
  with msesoftsurface into wl_shm buffers.
  Shows: window creation and configure/ack cycle, double buffered shm
  buffers with release handling, resize, pointer motion and buttons,
  interactive move/resize requested from the client (client side
  decoration), keyboard events, close.

  Build (from kernel/wayland, waylandcore.pas and waylandxdgshell.pas
  generated by wl2pas.py):
   fpc -Mobjfpc -FUunits -B -Fu../../graphics wlwindow.pas
  Run:
   WAYLAND_DISPLAY=wayland-1 ./wlwindow

  Mouse: left button on the blue bar moves the window, on the red square
  closes it, on the grip at the bottom right resizes it.
  Keyboard: Esc closes it. Everything is logged to the terminal. }
{$mode objfpc}{$h+}

uses
 ctypes,BaseUnix,msesoftsurface,waylandbase,waylandcore,waylandxdgshell,
 xkbcommon;

const
 titleheight = 30;
 gripsize = 24;
 closesize = 20;
 BTN_LEFT = $110;
 KEY_ESC = 1;

type
 bufferinfoty = record
  buffer: pointer;
  busy: boolean;
 end;
 pbufferinfoty = ^bufferinfoty;

var
 display,registry,compositor,shm,wmbase,seat: pointer;
 wlpointer,wlkeyboard,surface,xsurface,toplevel: pointer;
 width,height: integer;            //size asked by the compositor
 pw,ph: integer;                   //size of the allocated buffers
 poolmem: pointer;
 poolsize: integer;
 bufs: array[0..1] of bufferinfoty;
 configured,closing,needredraw,haspointer: boolean;
 mx,my: integer;
 xkbctx: pxkb_context;
 xkbmap: pxkb_keymap;
 xkbstate: pxkb_state;
 repeatrate,repeatdelay: integer;

function memfd_create(name: pchar; flags: cuint): cint; cdecl;
                                 external 'c' name 'memfd_create';

//buffers

procedure freebuffers;
var
 i: integer;
begin
 for i:= 0 to high(bufs) do begin
  if bufs[i].buffer <> nil then begin
   wl_buffer_destroy(bufs[i].buffer);
   bufs[i].buffer:= nil;
  end;
 end;
 if poolmem <> nil then begin
  fpmunmap(poolmem,poolsize);
  poolmem:= nil;
 end;
end;

procedure onrelease(data: pointer; buffer: pointer); cdecl;
begin
 pbufferinfoty(data)^.busy:= false;  //the main loop redraws if needed
end;

var
 bufferlistener: twl_buffer_listener;

procedure allocbuffers(const w,h: integer);
var
 fd,i,stride: integer;
 pool: pointer;
begin
 freebuffers;
 pw:= w;
 ph:= h;
 stride:= w * 4;
 poolsize:= stride * h * 2;
 fd:= memfd_create('wlwindow',0);
 if fd < 0 then begin
  writeln('memfd_create failed');
  halt(1);
 end;
 fpftruncate(fd,poolsize);
 poolmem:= fpmmap(nil,poolsize,PROT_READ or PROT_WRITE,MAP_SHARED,fd,0);
 if poolmem = pointer(-1) then begin
  writeln('mmap failed');
  halt(1);
 end;
 pool:= wl_shm_create_pool(shm,fd,poolsize);
 fpclose(fd);
 for i:= 0 to high(bufs) do begin
  bufs[i].buffer:= wl_shm_pool_create_buffer(pool,i * stride * h,w,h,stride,
                                                       wl_shm_format_argb8888);
  bufs[i].busy:= false;
  wl_buffer_add_listener(bufs[i].buffer,@bufferlistener,@bufs[i]);
 end;
 wl_shm_pool_destroy(pool);        //the buffers keep the memory alive
 writeln('buffers ',w,'x',h);
end;

//drawing

procedure draw;
var
 idx,i: integer;
 surf: psoftsurfacety;
begin
 if not configured then begin
  exit;
 end;
 if (width <> pw) or (height <> ph) or (poolmem = nil) then begin
  allocbuffers(width,height);
 end;
 idx:= -1;
 for i:= 0 to high(bufs) do begin
  if not bufs[i].busy then begin
   idx:= i;
   break;
  end;
 end;
 if idx < 0 then begin
  needredraw:= true;               //redrawn when a buffer is released
  exit;
 end;
 needredraw:= false;
 surf:= wrapsoftsurface(pbyte(poolmem) + idx * pw * 4 * ph,pw,ph,pw * 4);
 softclear(surf,$E8E8E8);
 softfillrect(surf,softrect(0,0,pw,titleheight),$2040A0,255);
 softfillrect(surf,softrect(pw - closesize - 6,5,closesize,closesize),
                                                              $C03030,255);
 softfillrect(surf,softrect(pw - gripsize,ph - gripsize,gripsize,gripsize),
                                                              $606060,255);
 softdrawline(surf,0,titleheight,pw - 1,titleheight,$000000,255);
 softdrawline(surf,0,titleheight + 1,pw - 1,ph - 1,$80A080,255);
 softdrawline(surf,0,ph - 1,pw - 1,titleheight + 1,$80A080,255);
 if haspointer then begin
  softdrawline(surf,0,my,pw - 1,my,$000000,80);
  softdrawline(surf,mx,0,mx,ph - 1,$000000,80);
  softfillrect(surf,softrect(mx - 8,my - 8,16,16),$FF0000,128);
 end;
 freesoftsurface(surf);
 wl_surface_attach(surface,bufs[idx].buffer,0,0);
 wl_surface_damage_buffer(surface,0,0,pw,ph);
 wl_surface_commit(surface);
 bufs[idx].busy:= true;
end;

//xdg shell

procedure onwmping(data: pointer; wm: pointer; serial: cuint32); cdecl;
begin
 xdg_wm_base_pong(wm,serial);
end;

procedure onxsurfaceconfigure(data: pointer; xs: pointer;
                                                serial: cuint32); cdecl;
begin
 xdg_surface_ack_configure(xs,serial);
 configured:= true;
 draw;
end;

procedure ontoplevelconfigure(data: pointer; tl: pointer; w,h: cint32;
                                                states: pwl_array); cdecl;
begin
 writeln('toplevel configure ',w,'x',h);
 if (w > 0) and (h > 0) then begin
  width:= w;
  height:= h;
 end;
end;

procedure ontoplevelclose(data: pointer; tl: pointer); cdecl;
begin
 writeln('toplevel close');
 closing:= true;
end;

//pointer

procedure onpenter(data: pointer; ptr: pointer; serial: cuint32;
                   surf: pointer; sx,sy: cint32); cdecl;
begin
 haspointer:= true;
 mx:= wl_fixed_to_int(sx);
 my:= wl_fixed_to_int(sy);
 writeln('pointer enter ',mx,',',my);
 draw;
end;

procedure onpleave(data: pointer; ptr: pointer; serial: cuint32;
                   surf: pointer); cdecl;
begin
 haspointer:= false;
 writeln('pointer leave');
 draw;
end;

procedure onpmotion(data: pointer; ptr: pointer; time: cuint32;
                   sx,sy: cint32); cdecl;
begin
 mx:= wl_fixed_to_int(sx);
 my:= wl_fixed_to_int(sy);
 draw;
end;

procedure onpbutton(data: pointer; ptr: pointer; serial,time,button,
                                                   state: cuint32); cdecl;
begin
 writeln('button ',hexstr(button,3),' state ',state,' at ',mx,',',my);
 if (state = 1) and (button = BTN_LEFT) then begin
  if (mx >= pw - gripsize) and (my >= ph - gripsize) then begin
   xdg_toplevel_resize(toplevel,seat,serial,
                                  xdg_toplevel_resize_edge_bottom_right);
  end
  else begin
   if my < titleheight then begin
    if mx >= pw - closesize - 6 then begin
     closing:= true;
    end
    else begin
     xdg_toplevel_move(toplevel,seat,serial);
    end;
   end;
  end;
 end;
end;

//keyboard

procedure onkkeymap(data: pointer; kb: pointer; format: cuint32; fd: cint32;
                                               size: cuint32); cdecl;
var
 map: pointer;
 str: pchar;
begin
 writeln('keymap format ',format,' size ',size);
 if xkbstate <> nil then begin
  xkb_state_unref(xkbstate);
  xkbstate:= nil;
 end;
 if xkbmap <> nil then begin
  xkb_keymap_unref(xkbmap);
  xkbmap:= nil;
 end;
 if format = 1 then begin          //WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1
  map:= fpmmap(nil,size,PROT_READ,MAP_PRIVATE,fd,0);
  if map <> pointer(-1) then begin
   getmem(str,size + 1);           //own copy with certain 0 termination
   move(map^,str^,size);
   str[size]:= #0;
   fpmunmap(map,size);
   xkbmap:= xkb_keymap_new_from_string(xkbctx,str,XKB_KEYMAP_FORMAT_TEXT_V1,
                                              XKB_KEYMAP_COMPILE_NO_FLAGS);
   freemem(str);
   if xkbmap <> nil then begin
    xkbstate:= xkb_state_new(xkbmap);
   end;
  end;
 end;
 writeln('xkb keymap ',xkbmap <> nil,' state ',xkbstate <> nil);
 fpclose(fd);
end;

procedure onkmodifiers(data: pointer; kb: pointer; serial,depressed,latched,
                                 locked,group: cuint32); cdecl;
begin
 if xkbstate <> nil then begin
  xkb_state_update_mask(xkbstate,depressed,latched,locked,0,0,group);
 end;
end;

procedure onkrepeatinfo(data: pointer; kb: pointer; rate,delay: cint32); cdecl;
begin
 repeatrate:= rate;
 repeatdelay:= delay;
 writeln('repeat rate ',rate,'/s delay ',delay,' ms');
end;

procedure onkenter(data: pointer; kb: pointer; serial: cuint32;
                                 surf: pointer; keys: pwl_array); cdecl;
begin
 writeln('keyboard enter');
end;

procedure onkleave(data: pointer; kb: pointer; serial: cuint32;
                                 surf: pointer); cdecl;
begin
 writeln('keyboard leave');
end;

procedure onkkey(data: pointer; kb: pointer; serial,time,key,
                                              state: cuint32); cdecl;
var
 sym: xkb_keysym_t;
 mods: string;
 utf: string;
 i: integer;
begin
 if xkbstate = nil then begin
  writeln('key ',key,' state ',state,' (no keymap)');
 end
 else begin
  sym:= xkb_state_key_get_one_sym(xkbstate,evdevtoxkb(key));
  mods:= '';
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_SHIFT,
                                     XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   mods:= mods + ' Shift';
  end;
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_CTRL,
                                     XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   mods:= mods + ' Ctrl';
  end;
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_ALT,
                                     XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   mods:= mods + ' Alt';
  end;
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_LOGO,
                                     XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   mods:= mods + ' Logo';
  end;
  utf:= '';
  if state = 1 then begin
   utf:= keyutf8(xkbstate,key);
  end;
  write('key ',key,' state ',state,' sym ',keysymname(sym),
                              ' ($',hexstr(sym,4),')');
  if utf <> '' then begin
   write(' utf8 "');
   for i:= 1 to length(utf) do begin
    if utf[i] < ' ' then begin
     write('^',chr(ord(utf[i]) + 64));
    end
    else begin
     write(utf[i]);
    end;
   end;
   write('"');
  end;
  writeln(' mods:',mods,' repeats ',
          xkb_keymap_key_repeats(xkbmap,evdevtoxkb(key)));
 end;
 if (key = KEY_ESC) and (state = 1) then begin
  closing:= true;
 end;
end;

//seat

var
 pl: twl_pointer_listener;         //must stay valid, libwayland keeps the
 kl: twl_keyboard_listener;        //pointers, so global and not local

procedure onseatcapabilities(data: pointer; st: pointer;
                                          caps: cuint32); cdecl;
begin
 writeln('seat capabilities ',caps);
 if (caps and 1 <> 0) and (wlpointer = nil) then begin
  wlpointer:= wl_seat_get_pointer(st);
  wl_pointer_noop_listener(pl);
  pl.enter:= @onpenter;
  pl.leave:= @onpleave;
  pl.motion:= @onpmotion;
  pl.button:= @onpbutton;
  wl_pointer_add_listener(wlpointer,@pl,nil);
 end;
 if (caps and 2 <> 0) and (wlkeyboard = nil) then begin
  wlkeyboard:= wl_seat_get_keyboard(st);
  wl_keyboard_noop_listener(kl);
  kl.keymap:= @onkkeymap;
  kl.enter:= @onkenter;
  kl.leave:= @onkleave;
  kl.key:= @onkkey;
  kl.modifiers:= @onkmodifiers;
  kl.repeat_info:= @onkrepeatinfo;
  wl_keyboard_add_listener(wlkeyboard,@kl,nil);
 end;
end;

procedure onseatname(data: pointer; st: pointer; name: pchar); cdecl;
begin
 writeln('seat name ',name);
end;

//registry

procedure onglobal(data: pointer; reg: pointer; name: cuint32;
                         iface: pchar; version: cuint32); cdecl;
var
 s: string;
begin
 s:= iface;
 if s = 'wl_compositor' then begin
  if version > 4 then begin
   version:= 4;                     //damage_buffer needs 4
  end;
  compositor:= wl_registry_bind(reg,name,@wl_compositor_interface,version);
 end
 else begin
  if s = 'wl_shm' then begin
   shm:= wl_registry_bind(reg,name,@wl_shm_interface,1);
  end
  else begin
   if s = 'xdg_wm_base' then begin
    if version > 3 then begin
     version:= 3;
    end;
    wmbase:= wl_registry_bind(reg,name,@xdg_wm_base_interface,version);
   end
   else begin
    if s = 'wl_seat' then begin
     if version > 5 then begin
      version:= 5;
     end;
     seat:= wl_registry_bind(reg,name,@wl_seat_interface,version);
    end;
   end;
  end;
 end;
end;

procedure onglobalremove(data: pointer; reg: pointer; name: cuint32); cdecl;
begin
end;

var
 rl: twl_registry_listener;
 wl: txdg_wm_base_listener;
 xl: txdg_surface_listener;
 tl: txdg_toplevel_listener;
 sl: twl_seat_listener;

begin
 width:= 640;
 height:= 480;
 xkbctx:= xkb_context_new(XKB_CONTEXT_NO_FLAGS);
 if xkbctx = nil then begin
  writeln('xkb_context_new failed');
  halt(1);
 end;
 display:= wl_display_connect(nil);
 if display = nil then begin
  writeln('cannot connect, is WAYLAND_DISPLAY set and weston running?');
  halt(1);
 end;
 wl_buffer_noop_listener(bufferlistener);
 bufferlistener.release:= @onrelease;

 registry:= wl_display_get_registry(display);
 wl_registry_noop_listener(rl);
 rl.global:= @onglobal;
 rl.global_remove:= @onglobalremove;
 wl_registry_add_listener(registry,@rl,nil);
 wl_display_roundtrip(display);
 if (compositor = nil) or (shm = nil) or (wmbase = nil) then begin
  writeln('missing wl_compositor, wl_shm or xdg_wm_base');
  halt(1);
 end;
 xdg_wm_base_noop_listener(wl);
 wl.ping:= @onwmping;
 xdg_wm_base_add_listener(wmbase,@wl,nil);
 if seat <> nil then begin
  wl_seat_noop_listener(sl);
  sl.capabilities:= @onseatcapabilities;
  sl.name:= @onseatname;
  wl_seat_add_listener(seat,@sl,nil);
 end;

 surface:= wl_compositor_create_surface(compositor);
 xsurface:= xdg_wm_base_get_xdg_surface(wmbase,surface);
 xdg_surface_noop_listener(xl);
 xl.configure:= @onxsurfaceconfigure;
 xdg_surface_add_listener(xsurface,@xl,nil);
 toplevel:= xdg_surface_get_toplevel(xsurface);
 xdg_toplevel_noop_listener(tl);
 tl.configure:= @ontoplevelconfigure;
 tl.close:= @ontoplevelclose;
 xdg_toplevel_add_listener(toplevel,@tl,nil);
 xdg_toplevel_set_title(toplevel,'MSEgui wayland prototype');
 xdg_toplevel_set_app_id(toplevel,'mseguiwl');
 wl_surface_commit(surface);        //initial commit without buffer

 while (not closing) and (wl_display_dispatch(display) >= 0) do begin
  if needredraw then begin
   draw;
  end;
 end;
 writeln('exit');
 freebuffers;
 if xkbstate <> nil then begin
  xkb_state_unref(xkbstate);
 end;
 if xkbmap <> nil then begin
  xkb_keymap_unref(xkbmap);
 end;
 xkb_context_unref(xkbctx);
 wl_display_disconnect(display);
end.
