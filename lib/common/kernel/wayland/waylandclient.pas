unit waylandclient;
{ Wayland client layer of the MSEgui pure Wayland backend.
  No MSEgui types here, only plain events in a queue.

  - connection, registry, wl_shm, xdg-shell, wl_seat, wl_output
  - windows: xdg toplevels and xdg popups (menus with grab, hints without),
    every window has a backing store (msesoftsurface) that wlc_present copies
    into a wl_shm buffer
  - pointer and keyboard (xkbcommon), key repeat
  - events are collected in a queue, read with wlc_nextevent

  Event loop, to be used by the caller:
    repeat
     while wlc_nextevent(ev) do handle(ev);
     fd:= wlc_pollprepare;
     if wlc_hasevents then wlc_pollfinish(false)
     else begin
      poll(fd and own fds, timeout = wlc_timeout(...));
      wlc_pollfinish(fd is readable);
     end;
     wlc_timers;
    until done;
}
{$mode objfpc}{$h+}

interface
uses
 ctypes,BaseUnix,sysutils,msesoftsurface,waylandbase,waylandcore,
 waylandxdgshell,xkbcommon;

type
 twlwindowkind = (wlk_toplevel,wlk_popup,wlk_tooltip);
 twleventkind = (wle_none,wle_configure,wle_expose,wle_close,wle_popupdone,
                 wle_keyboardenter,wle_keyboardleave,wle_pointerenter,
                 wle_pointerleave,wle_pointermotion,wle_button,wle_axis,
                 wle_axisdiscrete,wle_key);
 twlmod = (wlm_shift,wlm_ctrl,wlm_alt,wlm_logo,wlm_caps,wlm_num,wlm_altgr);
 twlmods = set of twlmod;

 twlwindow = class;

 twlbuffer = record
  buffer: pointer;
  busy: boolean;
  window: twlwindow;
 end;
 pwlbuffer = ^twlbuffer;

 twlwindow = class
  public
   kind: twlwindowkind;
   parent: twlwindow;
   surface,xsurface,toplevel,popup: pointer;
   width,height: integer;       //size of the client area = size of back
   back: psoftsurfacety;        //backing store, owned
   visible,configured,pendingpresent: boolean;
   maximized,fullscreen,activated: boolean;
   pendw,pendh: integer;        //size from the last configure, 0 = none
   title,appid: string;
   minw,minh,maxw,maxh: integer;
   popupx,popupy: integer;      //relative to the parent
   grab: boolean;
   bufs: array[0..1] of twlbuffer;
   poolmem: pointer;
   poolsize: integer;
   bufw,bufh: integer;
   posx,posy: integer;          //position in the virtual screen, set by the caller
   decorated: boolean;          //client side decoration (toplevels), default true
   cursorname: string;          //xcursor name for the client area, '' = default
   hoverzone: integer;          //decoration zone under the pointer, -1 = none
   inclient: boolean;           //pointer is in the client area
   lastclick: cuint32;          //time of the last title bar click
   titlecache: psoftsurfacety;
   titlekey: string;
   titlew: integer;
   titleact: boolean;
   decorstate: integer;
   minimized: boolean;          //set by the caller
   destructor destroy; override;
 end;

 twlevent = record
  kind: twleventkind;
  window: twlwindow;
  time: cuint32;               //ms
  x,y: integer;                //pointer position, configure: x = width, y = height
  button: cuint32;             //evdev button code ($110 left, $111 right, $112 middle)
  pressed: boolean;            //button, key
  axis: integer;               //0 vertical, 1 horizontal
  value: double;               //axis: pixels, axisdiscrete: steps
  key: cuint32;                //evdev key code
  keysym: xkb_keysym_t;
  keysym0: xkb_keysym_t;       //keysym without modifiers (level 0)
  utf8: string;
  mods: twlmods;
  repeated: boolean;           //key: generated by the key repeat
 end;

const
 BTN_LEFT = $110;
 BTN_RIGHT = $111;
 BTN_MIDDLE = $112;

type
 twltitlerenderer = function(const atitle: string; const w,h: integer;
                    const bg,fg: longword): psoftsurfacety;
                    //renders the title into a new surface w x h, bg = background
                    //color (RRGGBB), fg = text color, the caller frees the surface

var
 wlc_titlerenderer: twltitlerenderer;   //nil = no title text
 wlc_debug: boolean;                     //writes debug lines

procedure wlc_setdecorated(const win: twlwindow; const value: boolean);
procedure wlc_setcursor(const win: twlwindow; const aname: string);
                              //xcursor name, 'none' hides it, '' default

//connection
function wlc_connect: boolean;
procedure wlc_disconnect;
function wlc_connected: boolean;
procedure wlc_screensize(out w,h: integer);

//event loop support
function wlc_nextevent(out ev: twlevent): boolean;
function wlc_hasevents: boolean;
function wlc_pollprepare: cint;       //returns the fd to poll for POLLIN
procedure wlc_pollfinish(const readable: boolean);
function wlc_timeout(const maxms: integer): integer;
procedure wlc_timers;                 //key repeat
procedure wlc_flush;

//windows
function wlc_createwindow(const akind: twlwindowkind; const aparent: twlwindow;
                      const x,y,w,h: integer): twlwindow;
                      //x,y: popups only, relative to the parent
procedure wlc_destroywindow(const win: twlwindow);
procedure wlc_show(const win: twlwindow);
procedure wlc_hide(const win: twlwindow);
procedure wlc_setsize(const win: twlwindow; const w,h: integer);
procedure wlc_settitle(const win: twlwindow; const atitle: string);
procedure wlc_setsizeconstraints(const win: twlwindow; const minw,minh,maxw,maxh: integer);
procedure wlc_setmaximized(const win: twlwindow; const value: boolean);
procedure wlc_setfullscreen(const win: twlwindow; const value: boolean);
procedure wlc_setminimized(const win: twlwindow);
procedure wlc_move(const win: twlwindow);          //interactive, from a button press
procedure wlc_resize(const win: twlwindow; const edges: cuint32);
procedure wlc_present(const win: twlwindow);
function wlc_windowfromsurface(const asurface: pointer): twlwindow;

//clipboard, text only
function wlc_clipboardset(const utf8: string): boolean;
function wlc_clipboardcanpaste: boolean;
function wlc_clipboardget(out utf8: string): boolean;

var
 wlc_lastserial: cuint32;             //serial of the last input event

implementation

var
 display,registry,compositor,shm,wmbase,seat,output: pointer;
 wlpointer,wlkeyboard: pointer;
 xkbctx: pxkb_context;
 xkbmap: pxkb_keymap;
 xkbstate: pxkb_state;
 plainstate: pxkb_state;   //never updated: level 0 keysyms
 screenw,screenh: integer;
 evq: array of twlevent;
 evhead: integer;
 windows: array of twlwindow;
 pointerwin,keyboardwin: twlwindow;
 pointerx,pointery: integer;
 clientbuttons: integer;     //buttons pressed in the client area
 repeatrate,repeatdelay: integer;
 repeatkey: cuint32;
 repeatdue: qword;
 repeatsym: xkb_keysym_t;

 //listeners must stay valid, libwayland keeps the pointers
 rl: twl_registry_listener;
 wml: txdg_wm_base_listener;
 xsl: txdg_surface_listener;
 tll: txdg_toplevel_listener;
 pul: txdg_popup_listener;
 sl: twl_seat_listener;
 pl: twl_pointer_listener;
 kl: twl_keyboard_listener;
 ol: twl_output_listener;
 bl: twl_buffer_listener;

function memfd_create(name: pchar; flags: cuint): cint; cdecl;
                                 external 'c' name 'memfd_create';

//events

procedure pushevent(const ev: twlevent);
begin
 setlength(evq,length(evq) + 1);
 evq[high(evq)]:= ev;
end;

function newevent(const akind: twleventkind; const win: twlwindow): twlevent;
begin
 result:= default(twlevent);
 result.kind:= akind;
 result.window:= win;
 result.time:= cuint32(GetTickCount64);
end;

function wlc_nextevent(out ev: twlevent): boolean;
begin
 result:= evhead < length(evq);
 if result then begin
  ev:= evq[evhead];
  evq[evhead]:= default(twlevent);
  inc(evhead);
  if evhead >= length(evq) then begin
   setlength(evq,0);
   evhead:= 0;
  end;
 end
 else begin
  ev:= default(twlevent);
 end;
end;

function wlc_hasevents: boolean;
begin
 result:= evhead < length(evq);
end;

procedure purgeevents(const win: twlwindow);
var
 i: integer;
begin
 for i:= evhead to high(evq) do begin
  if evq[i].window = win then begin
   evq[i].kind:= wle_none;
   evq[i].window:= nil;
  end;
 end;
end;

function wlc_windowfromsurface(const asurface: pointer): twlwindow;
begin
 result:= nil;
 if asurface <> nil then begin
  result:= twlwindow(wl_proxy_get_user_data(asurface));
 end;
end;

function curmods: twlmods;
begin
 result:= [];
 if xkbstate <> nil then begin
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_SHIFT,
                                      XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   include(result,wlm_shift);
  end;
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_CTRL,
                                      XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   include(result,wlm_ctrl);
  end;
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_ALT,
                                      XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   include(result,wlm_alt);
  end;
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_LOGO,
                                      XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   include(result,wlm_logo);
  end;
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_CAPS,
                                      XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   include(result,wlm_caps);
  end;
  if xkb_state_mod_name_is_active(xkbstate,XKB_MOD_NAME_NUM,
                                      XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   include(result,wlm_num);
  end;
  if xkb_state_mod_name_is_active(xkbstate,'Mod5',
                                      XKB_STATE_MODS_EFFECTIVE) > 0 then begin
   include(result,wlm_altgr);
  end;
 end;
end;

//client side decorations

const
 wl_barheight = 28;
 wl_btnw = 34;
 wl_grip = 6;
 wl_corner = 14;
 wl_colbaract = $D8D8D8;
 wl_colbarinact = $E8E8E8;
 wl_colbtnhover = $BEBEBE;
 wl_colclosehover = $E04848;
 wl_colfg = $202020;
 wl_colborder = $8A8A8A;
 wl_colline = $B4B4B4;

function csd(const win: twlwindow): boolean;
begin
 result:= win.decorated and (win.kind = wlk_toplevel) and not win.fullscreen;
end;

function bdr(const win: twlwindow): integer;   //border width
begin
 if csd(win) and not win.maximized then begin
  result:= 4;
 end
 else begin
  result:= 0;
 end;
end;

function offx(const win: twlwindow): integer;  //client origin in the surface
begin
 result:= bdr(win);
end;

function offy(const win: twlwindow): integer;
begin
 if csd(win) then begin
  result:= wl_barheight;
 end
 else begin
  result:= 0;
 end;
end;

function outw(const win: twlwindow): integer;  //size of the surface
begin
 result:= win.width + 2 * offx(win);
end;

function outh(const win: twlwindow): integer;
begin
 result:= win.height + offy(win) + offx(win);
end;

function hittest(const win: twlwindow; const sx,sy: integer): integer;
              //0 client, 1 title, 2 close, 3 maximize, 4 minimize,
              //100 + xdg resize edge bits
var
 ow,oh,edges: integer;
begin
 result:= 0;
 if not csd(win) then begin
  exit;
 end;
 ow:= outw(win);
 oh:= outh(win);
 if not win.maximized then begin
  edges:= 0;
  if sx < wl_grip then edges:= edges or 4;
  if sx >= ow - wl_grip then edges:= edges or 8;
  if sy < wl_grip then edges:= edges or 1;
  if sy >= oh - wl_grip then edges:= edges or 2;
  if edges = 0 then begin                      //larger corner zones
   if (sx < wl_corner) and (sy < wl_corner) then edges:= 5;
   if (sx >= ow - wl_corner) and (sy < wl_corner) then edges:= 9;
   if (sx < wl_corner) and (sy >= oh - wl_corner) then edges:= 6;
   if (sx >= ow - wl_corner) and (sy >= oh - wl_corner) then edges:= 10;
  end
  else begin
   if (edges = 4) or (edges = 8) then begin    //near a corner on a side edge
    if sy < wl_corner then edges:= edges or 1;
    if sy >= oh - wl_corner then edges:= edges or 2;
   end
   else begin
    if (edges = 1) or (edges = 2) then begin
     if sx < wl_corner then edges:= edges or 4;
     if sx >= ow - wl_corner then edges:= edges or 8;
    end;
   end;
  end;
  if edges <> 0 then begin
   result:= 100 + edges;
   exit;
  end;
 end;
 if sy < wl_barheight then begin
  if sx >= ow - wl_btnw then begin
   result:= 2;
  end
  else begin
   if sx >= ow - 2 * wl_btnw then begin
    result:= 3;
   end
   else begin
    if sx >= ow - 3 * wl_btnw then begin
     result:= 4;
    end
    else begin
     result:= 1;
    end;
   end;
  end;
 end;
end;

procedure drawdecoration(const win: twlwindow; const dst: psoftsurfacety);
var
 ow,oh,b,i,x0,cx,cy,tw,bar: integer;
 hc,gc: longword;
begin
 ow:= outw(win);
 oh:= outh(win);
 b:= bdr(win);
 if win.activated then begin
  bar:= wl_colbaract;
 end
 else begin
  bar:= wl_colbarinact;
 end;
 softfillrect(dst,softrect(0,0,ow,wl_barheight),bar,255);
 softfillrect(dst,softrect(0,wl_barheight - 1,ow,1),wl_colline,255);
 if b > 0 then begin
  softfillrect(dst,softrect(0,0,b,oh),bar,255);
  softfillrect(dst,softrect(ow - b,0,b,oh),bar,255);
  softfillrect(dst,softrect(0,oh - b,ow,b),bar,255);
  softfillrect(dst,softrect(0,0,ow,1),wl_colborder,255);            //outline
  softfillrect(dst,softrect(0,0,1,oh),wl_colborder,255);
  softfillrect(dst,softrect(ow - 1,0,1,oh),wl_colborder,255);
  softfillrect(dst,softrect(0,oh - 1,ow,1),wl_colborder,255);
  softfillrect(dst,softrect(b - 1,wl_barheight,1,oh - wl_barheight - b + 1),
                                                           wl_colline,255);
  softfillrect(dst,softrect(ow - b,wl_barheight,1,oh - wl_barheight - b + 1),
                                                           wl_colline,255);
  softfillrect(dst,softrect(b - 1,oh - b,ow - 2 * b + 2,1),wl_colline,255);
 end;
 cy:= wl_barheight div 2;
 for i:= 2 to 4 do begin
  x0:= ow - (i - 1) * wl_btnw;
  cx:= x0 + wl_btnw div 2;
  if win.hoverzone = i then begin
   if i = 2 then begin
    hc:= wl_colclosehover;
   end
   else begin
    hc:= wl_colbtnhover;
   end;
   softfillrect(dst,softrect(x0,0,wl_btnw,wl_barheight),hc,255);
  end;
  gc:= wl_colfg;
  if (i = 2) and (win.hoverzone = 2) then begin
   gc:= $FFFFFF;
  end;
  case i of
   2: begin                                   //close
    softdrawline(dst,cx - 5,cy - 5,cx + 5,cy + 5,gc,255);
    softdrawline(dst,cx - 5,cy + 5,cx + 5,cy - 5,gc,255);
    softdrawline(dst,cx - 4,cy - 5,cx + 6,cy + 5,gc,255);
    softdrawline(dst,cx - 4,cy + 5,cx + 6,cy - 5,gc,255);
   end;
   3: begin                                   //maximize
    softdrawline(dst,cx - 5,cy - 5,cx + 5,cy - 5,gc,255);
    softdrawline(dst,cx - 5,cy + 5,cx + 5,cy + 5,gc,255);
    softdrawline(dst,cx - 5,cy - 5,cx - 5,cy + 5,gc,255);
    softdrawline(dst,cx + 5,cy - 5,cx + 5,cy + 5,gc,255);
    softdrawline(dst,cx - 5,cy - 4,cx + 5,cy - 4,gc,255);
   end;
   4: begin                                   //minimize
    softdrawline(dst,cx - 5,cy + 4,cx + 5,cy + 4,gc,255);
    softdrawline(dst,cx - 5,cy + 5,cx + 5,cy + 5,gc,255);
   end;
  end;
 end;
 tw:= ow - 6 * wl_btnw;                   //centered between symmetric margins
 if (tw > 0) and (win.title <> '') and assigned(wlc_titlerenderer) then begin
  if (win.titlecache = nil) or (win.titlekey <> win.title) or
         (win.titlew <> tw) or (win.titleact <> win.activated) then begin
   if win.titlecache <> nil then begin
    freesoftsurface(win.titlecache);
   end;
   win.titlecache:= wlc_titlerenderer(win.title,tw,wl_barheight,bar,wl_colfg);
   win.titlekey:= win.title;
   win.titlew:= tw;
   win.titleact:= win.activated;
  end;
  if win.titlecache <> nil then begin
   softcopy(dst,3 * wl_btnw,0,win.titlecache,
            softrect(0,0,win.titlecache^.width,win.titlecache^.height),false);
  end;
 end;
end;

procedure applyconstraints(const win: twlwindow);
var
 ex,ey: integer;
begin
 if win.toplevel <> nil then begin
  ex:= 2 * offx(win);
  ey:= offy(win) + offx(win);
  if wlc_debug then begin
   writeln('constraints min ',win.minw,'x',win.minh,' max ',win.maxw,'x',
                                                       win.maxh);
   flush(system.output);
  end;
  if (win.minw > 0) or (win.minh > 0) then begin
   xdg_toplevel_set_min_size(win.toplevel,win.minw + ex,win.minh + ey);
  end;
  if (win.maxw > 0) or (win.maxh > 0) then begin
   xdg_toplevel_set_max_size(win.toplevel,win.maxw + ex,win.maxh + ey);
  end;
 end;
end;

procedure wlc_setdecorated(const win: twlwindow; const value: boolean);
begin
 if win <> nil then begin
  win.decorated:= value;
 end;
end;

//shm buffers

procedure freebuffers(const win: twlwindow);
var
 i: integer;
begin
 with win do begin
  for i:= 0 to high(bufs) do begin
   if bufs[i].buffer <> nil then begin
    wl_buffer_destroy(bufs[i].buffer);
    bufs[i].buffer:= nil;
   end;
   bufs[i].busy:= false;
  end;
  if poolmem <> nil then begin
   fpmunmap(poolmem,poolsize);
   poolmem:= nil;
  end;
  bufw:= 0;
  bufh:= 0;
 end;
end;

procedure onrelease(data: pointer; buffer: pointer); cdecl;
var
 win: twlwindow;
begin
 pwlbuffer(data)^.busy:= false;
 win:= pwlbuffer(data)^.window;
 if (win <> nil) and win.pendingpresent then begin
  wlc_present(win);
 end;
end;

function allocbuffers(const win: twlwindow): boolean;
var
 fd,i,stride: integer;
 pool: pointer;
begin
 result:= false;
 with win do begin
  freebuffers(win);
  stride:= outw(win) * 4;
  poolsize:= stride * outh(win) * 2;
  fd:= memfd_create('mseguiwl',0);
  if fd < 0 then begin
   exit;
  end;
  fpftruncate(fd,poolsize);
  poolmem:= fpmmap(nil,poolsize,PROT_READ or PROT_WRITE,MAP_SHARED,fd,0);
  if poolmem = pointer(-1) then begin
   poolmem:= nil;
   fpclose(fd);
   exit;
  end;
  pool:= wl_shm_create_pool(shm,fd,poolsize);
  fpclose(fd);
  for i:= 0 to high(bufs) do begin
   bufs[i].window:= win;
   bufs[i].busy:= false;
   bufs[i].buffer:= wl_shm_pool_create_buffer(pool,i * stride * outh(win),
                         outw(win),outh(win),stride,wl_shm_format_argb8888);
   wl_buffer_add_listener(bufs[i].buffer,@bl,@bufs[i]);
  end;
  wl_shm_pool_destroy(pool);       //the buffers keep the memory alive
  bufw:= outw(win);
  bufh:= outh(win);
 end;
 result:= true;
end;

procedure wlc_present(const win: twlwindow);
var
 i,idx: integer;
 dst: psoftsurfacety;
begin
 if (win = nil) or (win.back = nil) then begin
  exit;
 end;
 with win do begin
  if not visible or (surface = nil) or not configured then begin
   pendingpresent:= true;           //done when the window is configured
   exit;
  end;
  if (poolmem = nil) or (bufw <> outw(win)) or (bufh <> outh(win)) then begin
   if not allocbuffers(win) then begin
    exit;
   end;
  end;
  idx:= -1;
  for i:= 0 to high(bufs) do begin
   if not bufs[i].busy then begin
    idx:= i;
    break;
   end;
  end;
  if idx < 0 then begin
   pendingpresent:= true;           //done when a buffer is released
   exit;
  end;
  pendingpresent:= false;
  dst:= wrapsoftsurface(pbyte(poolmem) + idx * bufw * 4 * bufh,
                                              bufw,bufh,bufw * 4);
  if csd(win) then begin
   softclear(dst,0);
   drawdecoration(win,dst);
  end;
  softcopy(dst,offx(win),offy(win),back,softrect(0,0,width,height),false);
  freesoftsurface(dst);
  wl_surface_attach(surface,bufs[idx].buffer,0,0);
  wl_surface_damage_buffer(surface,0,0,bufw,bufh);
  wl_surface_commit(surface);
  bufs[idx].busy:= true;
 end;
end;

//windows

destructor twlwindow.destroy;
begin
 if back <> nil then begin
  freesoftsurface(back);
 end;
 if titlecache <> nil then begin
  freesoftsurface(titlecache);
 end;
 inherited;
end;

procedure applysize(const win: twlwindow; const w,h: integer);
begin
 if (w > 0) and (h > 0) then begin
  win.width:= w;
  win.height:= h;
  if win.back = nil then begin
   win.back:= createsoftsurface(w,h);
  end
  else begin
   softresize(win.back,w,h);
  end;
 end;
end;

procedure onwmping(data: pointer; wm: pointer; serial: cuint32); cdecl;
begin
 xdg_wm_base_pong(wm,serial);
end;

procedure onxsconfigure(data: pointer; xs: pointer; serial: cuint32); cdecl;
var
 win: twlwindow;
 first,changed: boolean;
 ev: twlevent;
 i: integer;
begin
 win:= twlwindow(data);
 xdg_surface_ack_configure(xs,serial);
 first:= not win.configured;
 win.configured:= true;
 changed:= false;
 if (win.pendw - 2 * offx(win) > 0) and (win.pendh - offy(win) - offx(win) > 0) and
     ((win.pendw - 2 * offx(win) <> win.width) or
      (win.pendh - offy(win) - offx(win) <> win.height)) then begin
  applysize(win,win.pendw - 2 * offx(win),win.pendh - offy(win) - offx(win));
  ev:= newevent(wle_configure,win);
  ev.x:= win.width;
  ev.y:= win.height;
  pushevent(ev);
  changed:= true;
 end;
 if first or changed then begin
  pushevent(newevent(wle_expose,win));
 end;
 if win.pendingpresent then begin
  wlc_present(win);
 end
 else begin
  i:= ord(win.activated) + 2 * ord(win.maximized) + 4 * ord(win.fullscreen);
  if i <> win.decorstate then begin       //decoration changed, redraw it
   win.decorstate:= i;
   wlc_present(win);
  end;
 end;
end;

procedure ontlconfigure(data: pointer; tl: pointer; w,h: cint32;
                                               states: pwl_array); cdecl;
var
 win: twlwindow;
 po: pcuint32;
 i: integer;
begin
 win:= twlwindow(data);
 win.pendw:= w;
 win.pendh:= h;
 win.maximized:= false;
 win.fullscreen:= false;
 win.activated:= false;
 if states <> nil then begin
  po:= states^.data;
  for i:= 0 to integer(states^.size div sizeof(cuint32)) - 1 do begin
   case po^ of
    1: win.maximized:= true;
    2: win.fullscreen:= true;
    4: win.activated:= true;
   end;
   inc(po);
  end;
 end;
end;

procedure ontlclose(data: pointer; tl: pointer); cdecl;
begin
 pushevent(newevent(wle_close,twlwindow(data)));
end;

procedure onpopupconfigure(data: pointer; po: pointer; x,y,w,h: cint32); cdecl;
var
 win: twlwindow;
begin
 win:= twlwindow(data);
 win.pendw:= w;
 win.pendh:= h;
end;

procedure onpopupdone(data: pointer; po: pointer); cdecl;
begin
 pushevent(newevent(wle_popupdone,twlwindow(data)));
end;

function wlc_createwindow(const akind: twlwindowkind; const aparent: twlwindow;
                      const x,y,w,h: integer): twlwindow;
begin
 result:= twlwindow.create;
 with result do begin
  kind:= akind;
  parent:= aparent;
  popupx:= x;
  popupy:= y;
  grab:= akind = wlk_popup;
  decorated:= akind = wlk_toplevel;
  hoverzone:= -1;
  decorstate:= -1;
  appid:= 'msegui';
 end;
 applysize(result,w,h);
 setlength(windows,length(windows) + 1);
 windows[high(windows)]:= result;
end;

procedure wlc_show(const win: twlwindow);
var
 pos: pointer;
begin
 if (win = nil) or win.visible or (compositor = nil) then begin
  exit;
 end;
 with win do begin
  surface:= wl_compositor_create_surface(compositor);
  wl_proxy_set_user_data(surface,win);
  xsurface:= xdg_wm_base_get_xdg_surface(wmbase,surface);
  xdg_surface_add_listener(xsurface,@xsl,win);
  pendw:= 0;
  pendh:= 0;
  if (kind = wlk_toplevel) or (parent = nil) or (parent.xsurface = nil) then begin
   toplevel:= xdg_surface_get_toplevel(xsurface);
   xdg_toplevel_add_listener(toplevel,@tll,win);
   xdg_toplevel_set_title(toplevel,pchar(title));
   xdg_toplevel_set_app_id(toplevel,pchar(appid));
   if (parent <> nil) and (parent.toplevel <> nil) then begin
    xdg_toplevel_set_parent(toplevel,parent.toplevel);
   end;
   applyconstraints(win);
  end
  else begin
   pos:= xdg_wm_base_create_positioner(wmbase);
   xdg_positioner_set_size(pos,outw(win),outh(win));
   xdg_positioner_set_anchor_rect(pos,popupx + offx(parent),popupy + offy(parent),1,1);
   xdg_positioner_set_anchor(pos,xdg_positioner_anchor_top_left);
   xdg_positioner_set_gravity(pos,xdg_positioner_gravity_bottom_right);
   xdg_positioner_set_constraint_adjustment(pos,0);
   popup:= xdg_surface_get_popup(xsurface,parent.xsurface,pos);
   xdg_positioner_destroy(pos);
   xdg_popup_add_listener(popup,@pul,win);
   if grab and (seat <> nil) then begin
    xdg_popup_grab(popup,seat,wlc_lastserial);
   end;
  end;
  visible:= true;
  configured:= false;
  wl_surface_commit(surface);       //initial commit without a buffer
 end;
end;

procedure wlc_hide(const win: twlwindow);
var
 i: integer;
begin
 if (win = nil) or not win.visible then begin
  exit;
 end;
 for i:= high(windows) downto 0 do begin   //xdg: popups must be destroyed
  if (windows[i] <> win) and (windows[i].parent = win) and  //topmost first
                  windows[i].visible and (windows[i].popup <> nil) then begin
   wlc_hide(windows[i]);
  end;
 end;
 with win do begin
  if pointerwin = win then begin
   pointerwin:= nil;
  end;
  if keyboardwin = win then begin
   keyboardwin:= nil;
   repeatkey:= 0;
  end;
  freebuffers(win);
  if popup <> nil then begin
   xdg_popup_destroy(popup);
   popup:= nil;
  end;
  if toplevel <> nil then begin
   xdg_toplevel_destroy(toplevel);
   toplevel:= nil;
  end;
  if xsurface <> nil then begin
   xdg_surface_destroy(xsurface);
   xsurface:= nil;
  end;
  if surface <> nil then begin
   wl_surface_destroy(surface);
   surface:= nil;
  end;
  visible:= false;
  configured:= false;
  pendingpresent:= false;
 end;
 purgeevents(win);
end;

procedure wlc_destroywindow(const win: twlwindow);
var
 i: integer;
begin
 if win = nil then begin
  exit;
 end;
 wlc_hide(win);
 for i:= 0 to high(windows) do begin
  if windows[i].parent = win then begin
   windows[i].parent:= nil;
  end;
 end;
 for i:= 0 to high(windows) do begin
  if windows[i] = win then begin
   windows[i]:= windows[high(windows)];
   setlength(windows,high(windows));
   break;
  end;
 end;
 win.free;
end;

procedure wlc_setsize(const win: twlwindow; const w,h: integer);
begin
 if (win <> nil) and (w > 0) and (h > 0) and
              ((w <> win.width) or (h <> win.height)) then begin
  applysize(win,w,h);
 end;
end;

procedure wlc_settitle(const win: twlwindow; const atitle: string);
begin
 if win <> nil then begin
  win.title:= atitle;
  if win.toplevel <> nil then begin
   xdg_toplevel_set_title(win.toplevel,pchar(atitle));
  end;
  if csd(win) and win.visible then begin
   wlc_present(win);                //title bar shows the new title
  end;
