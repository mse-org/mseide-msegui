procedure wlc_resize(const win: twlwindow; const edges: cuint32);
begin
 if (win <> nil) and (win.toplevel <> nil) and (seat <> nil) then begin
  xdg_toplevel_resize(win.toplevel,seat,wlc_lastserial,edges);
 end;
end;

