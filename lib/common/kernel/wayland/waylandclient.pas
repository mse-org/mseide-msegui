//clipboard

type
 twloffer = class
  proxy: pointer;
  mimes: array of string;
  procedure addmime(const amime: string);
  function textmime: string;
 end;

var
 ddm,ddev: pointer;                 //data device manager, data device
 ddl: twl_data_device_listener;
 dol: twl_data_offer_listener;
 dsl: twl_data_source_listener;
 offers: array of twloffer;         //all live offers
 seloffer: twloffer;                //current selection offer
 srcobj: pointer;                   //our data source, nil if not owner
 srctext: string;                   //utf8 text of our data source

procedure twloffer.addmime(const amime: string);
begin
 setlength(mimes,length(mimes) + 1);
 mimes[high(mimes)]:= amime;
end;

function twloffer.textmime: string;
const
 names: array[0..3] of string = ('text/plain;charset=utf-8','UTF8_STRING',
                                                       'text/plain','TEXT');
var
 i,j: integer;
begin
 result:= '';
 for j:= 0 to high(names) do begin
  for i:= 0 to high(mimes) do begin
   if mimes[i] = names[j] then begin
    result:= names[j];
    exit;
   end;
  end;
 end;
end;

function findoffer(const aproxy: pointer): twloffer;
var
 i: integer;
begin
 result:= nil;
 for i:= 0 to high(offers) do begin
  if offers[i].proxy = aproxy then begin
   result:= offers[i];
   exit;
  end;
 end;
end;

procedure freeoffer(const aoffer: twloffer);
var
 i: integer;
begin
 if aoffer = nil then begin
  exit;
 end;
 for i:= 0 to high(offers) do begin
  if offers[i] = aoffer then begin
   offers[i]:= offers[high(offers)];
   setlength(offers,high(offers));
   break;
  end;
 end;
 if seloffer = aoffer then begin
  seloffer:= nil;
 end;
 if aoffer.proxy <> nil then begin
  wl_data_offer_destroy(aoffer.proxy);
 end;
 aoffer.free;
end;

procedure onofferoffer(data: pointer; ofr: pointer; mime_type: pchar); cdecl;
var
 o: twloffer;
begin
 o:= findoffer(ofr);
 if o <> nil then begin
  o.addmime(mime_type);
 end;
end;

procedure onddataoffer(data: pointer; dev: pointer; id: pointer); cdecl;
var
 o: twloffer;
begin
 o:= twloffer.create;
 o.proxy:= id;
 setlength(offers,length(offers) + 1);
 offers[high(offers)]:= o;
 wl_data_offer_add_listener(id,@dol,nil);
end;

procedure onddselection(data: pointer; dev: pointer; id: pointer); cdecl;
var
 i: integer;
begin
 if id = nil then begin
  seloffer:= nil;
 end
 else begin
  seloffer:= findoffer(id);
 end;
 for i:= high(offers) downto 0 do begin   //only the selection is of interest
  if offers[i] <> seloffer then begin
   freeoffer(offers[i]);
  end;
 end;
end;

procedure onsrcsend(data: pointer; src: pointer; mime_type: pchar;
                                                  fd: cint32); cdecl;
var
 p: pchar;
 n,done,res: ptrint;
 pfd: tpollfd;
 t0: qword;
begin
 p:= pchar(srctext);
 n:= length(srctext);
 done:= 0;
 t0:= gettickcount64;
 fpfcntl(fd,F_SETFL,O_NONBLOCK);
 while done < n do begin
  res:= fpwrite(fd,(p + done)^,n - done);
  if res > 0 then begin
   done:= done + res;
  end
  else begin
   if (res < 0) and (fpgeterrno = ESysEAGAIN) then begin
    pfd.fd:= fd;
    pfd.events:= POLLOUT;
    pfd.revents:= 0;
    fppoll(@pfd,1,500);
   end
   else begin
    if (res = 0) or (fpgeterrno <> ESysEINTR) then begin
     break;
    end;
   end;
  end;
  if gettickcount64 - t0 > 3000 then begin
   break;                           //reader too slow
  end;
 end;
 fpclose(fd);
end;

procedure onsrccancelled(data: pointer; src: pointer); cdecl;
begin
 if src = srcobj then begin
  srcobj:= nil;
  srctext:= '';
 end;
 wl_data_source_destroy(src);
end;

function wlc_clipboardset(const utf8: string): boolean;
var
 src: pointer;
begin
 result:= false;
 if (ddm = nil) or (ddev = nil) then begin
  exit;
 end;
 src:= wl_data_device_manager_create_data_source(ddm);
 if src = nil then begin
  exit;
 end;
 wl_data_source_noop_listener(dsl);
 dsl.send:= @onsrcsend;
 dsl.cancelled:= @onsrccancelled;
 wl_data_source_add_listener(src,@dsl,nil);
 wl_data_source_offer(src,'text/plain;charset=utf-8');
 wl_data_source_offer(src,'UTF8_STRING');
 wl_data_source_offer(src,'text/plain');
 wl_data_source_offer(src,'TEXT');
 srctext:= utf8;
 srcobj:= src;       //the old source gets cancelled by the compositor
 wl_data_device_set_selection(ddev,src,wlc_lastserial);
 wl_display_flush(display);
 result:= true;
end;

function wlc_clipboardcanpaste: boolean;
begin
 result:= (srcobj <> nil) or ((seloffer <> nil) and (seloffer.textmime <> ''));
end;

function wlc_clipboardget(out utf8: string): boolean;
var
 mime: string;
 fds: tfildes;
 buf: array[0..4095] of char;
 n: ptrint;
 l: integer;
 pfd: tpollfd;
 t0: qword;
begin
 utf8:= '';
 result:= false;
 if srcobj <> nil then begin           //we are the owner
  utf8:= srctext;
  result:= true;
  exit;
 end;
 if seloffer = nil then begin
  exit;
 end;
 mime:= seloffer.textmime;
 if mime = '' then begin
  exit;
 end;
 if fppipe(fds) <> 0 then begin
  exit;
 end;
 wl_data_offer_receive(seloffer.proxy,pchar(mime),fds[1]);
 wl_display_flush(display);
 fpclose(fds[1]);
 t0:= gettickcount64;
 while gettickcount64 - t0 < 3000 do begin
  pfd.fd:= fds[0];
  pfd.events:= POLLIN;
  pfd.revents:= 0;
  n:= fppoll(@pfd,1,500);
  if n < 0 then begin
   if fpgeterrno <> ESysEINTR then begin
    break;
   end;
  end
  else begin
   if n > 0 then begin
    n:= fpread(fds[0],buf,sizeof(buf));
    if n > 0 then begin
     l:= length(utf8);
     setlength(utf8,l + n);
     move(buf,utf8[l + 1],n);
    end
    else begin
     if n = 0 then begin             //end of data
      result:= true;
      break;
     end
     else begin
      if fpgeterrno <> ESysEINTR then begin
       break;
      end;
     end;
    end;
   end;
  end;
 end;
 fpclose(fds[0]);
end;

procedure onseatcapabilities(data: pointer; st: pointer;
                                          caps: cuint32); cdecl;
begin
 if (caps and 1 <> 0) and (wlpointer = nil) then begin
  wlpointer:= wl_seat_get_pointer(st);
  wl_pointer_noop_listener(pl);
  pl.enter:= @onpenter;
  pl.leave:= @onpleave;
  pl.motion:= @onpmotion;
  pl.button:= @onpbutton;
  pl.axis:= @onpaxis;
  pl.axis_discrete:= @onpaxisdiscrete;
  wl_pointer_add_listener(wlpointer,@pl,nil);
 end;
 if (caps and 2 <> 0) and (wlkeyboard = nil) then begin
  wlkeyboard:= wl_seat_get_keyboard(st);
  wl_keyboard_noop_listener(kl);
  kl.keymap:= @onkkeymap;
  kl.enter:= @onkenter;
  kl.leave:= @onkleave;
  kl.key:= @onkkey;
  kl.modifiers:= @onkmodifiers;
  kl.repeat_info:= @onkrepeatinfo;
  wl_keyboard_add_listener(wlkeyboard,@kl,nil);
 end;
end;

procedure onoutputmode(data: pointer; op: pointer; flags: cuint32;
                                     w,h,refresh: cint32); cdecl;
begin
 if (flags and 1 <> 0) or (screenw = 0) then begin   //WL_OUTPUT_MODE_CURRENT
  screenw:= w;
  screenh:= h;
 end;
end;

procedure wlc_screensize(out w,h: integer);
begin
 w:= screenw;
 h:= screenh;
 if (w <= 0) or (h <= 0) then begin
  w:= 1024;                         //MSEgui must never see an empty screen
  h:= 768;
 end;
end;

//registry

procedure onglobal(data: pointer; reg: pointer; name: cuint32;
                         iface: pchar; version: cuint32); cdecl;
var
 s: string;
begin
 s:= iface;
 if s = 'wl_data_device_manager' then begin
  if version > 3 then begin
   version:= 3;
  end;
  ddm:= wl_registry_bind(reg,name,@wl_data_device_manager_interface,version);
 end;
 if s = 'wl_compositor' then begin
  if version > 4 then begin
   version:= 4;                     //damage_buffer needs 4
  end;
  compositor:= wl_registry_bind(reg,name,@wl_compositor_interface,version);
 end
 else begin
  if s = 'wl_shm' then begin
   shm:= wl_registry_bind(reg,name,@wl_shm_interface,1);
  end
  else begin
   if s = 'xdg_wm_base' then begin
    if version > 3 then begin
     version:= 3;
    end;
    wmbase:= wl_registry_bind(reg,name,@xdg_wm_base_interface,version);
   end
   else begin
    if s = 'wl_seat' then begin
     if version > 5 then begin
      version:= 5;
     end;
     seat:= wl_registry_bind(reg,name,@wl_seat_interface,version);
    end
    else begin
     if (s = 'wl_output') and (output = nil) then begin
      if version > 2 then begin
       version:= 2;
      end;
      output:= wl_registry_bind(reg,name,@wl_output_interface,version);
     end;
    end;
   end;
  end;
 end;
end;

procedure onglobalremove(data: pointer; reg: pointer; name: cuint32); cdecl;
begin
end;

//connection

function wlc_connect: boolean;
begin
 result:= false;
 xkbctx:= xkb_context_new(XKB_CONTEXT_NO_FLAGS);
 display:= wl_display_connect(nil);
 if (display = nil) or (xkbctx = nil) then begin
  exit;
 end;
 wl_buffer_noop_listener(bl);
 bl.release:= @onrelease;
 registry:= wl_display_get_registry(display);
 wl_registry_noop_listener(rl);
 rl.global:= @onglobal;
 rl.global_remove:= @onglobalremove;
 wl_registry_add_listener(registry,@rl,nil);
 wl_display_roundtrip(display);
 if (compositor = nil) or (shm = nil) or (wmbase = nil) then begin
  exit;
 end;
 xdg_wm_base_noop_listener(wml);
 wml.ping:= @onwmping;
 xdg_wm_base_add_listener(wmbase,@wml,nil);
 xdg_surface_noop_listener(xsl);
 xsl.configure:= @onxsconfigure;
 xdg_toplevel_noop_listener(tll);
 tll.configure:= @ontlconfigure;
 tll.close:= @ontlclose;
 xdg_popup_noop_listener(pul);
 pul.configure:= @onpopupconfigure;
 pul.popup_done:= @onpopupdone;
 if output <> nil then begin
  wl_output_noop_listener(ol);
  ol.mode:= @onoutputmode;
  wl_output_add_listener(output,@ol,nil);
 end;
 if seat <> nil then begin
  wl_seat_noop_listener(sl);
  sl.capabilities:= @onseatcapabilities;
  wl_seat_add_listener(seat,@sl,nil);
 end;
 if (ddm <> nil) and (seat <> nil) then begin
  wl_data_device_noop_listener(ddl);
  ddl.data_offer:= @onddataoffer;
  ddl.selection:= @onddselection;
  wl_data_offer_noop_listener(dol);
  dol.offer:= @onofferoffer;
  ddev:= wl_data_device_manager_get_data_device(ddm,seat);
  wl_data_device_add_listener(ddev,@ddl,nil);
 end;
 fpsignal(SIGPIPE,signalhandler(SIG_IGN));   //clipboard readers can go away
 wl_display_roundtrip(display);      //seat capabilities, output mode
 wl_display_roundtrip(display);      //keymap, repeat info
 result:= true;
end;

function wlc_connected: boolean;
begin
 result:= display <> nil;
end;

procedure wlc_disconnect;
begin
 while length(windows) > 0 do begin
  wlc_destroywindow(windows[high(windows)]);
 end;
 if xkbstate <> nil then begin
  xkb_state_unref(xkbstate);
  xkbstate:= nil;
 end;
 if plainstate <> nil then begin
  xkb_state_unref(plainstate);
  plainstate:= nil;
 end;
 if xkbmap <> nil then begin
  xkb_keymap_unref(xkbmap);
  xkbmap:= nil;
 end;
 if xkbctx <> nil then begin
  xkb_context_unref(xkbctx);
  xkbctx:= nil;
 end;
 if display <> nil then begin
  wl_display_flush(display);
  wl_display_disconnect(display);
  display:= nil;
 end;
 ddm:= nil;
 ddev:= nil;
 seloffer:= nil;
 srcobj:= nil;
 setlength(offers,0);
 compositor:= nil;
 shm:= nil;
 wmbase:= nil;
 seat:= nil;
 output:= nil;
 wlpointer:= nil;
 wlkeyboard:= nil;
 setlength(evq,0);
 evhead:= 0;
end;

//event loop support

function wlc_pollprepare: cint;
begin
 while wl_display_prepare_read(display) <> 0 do begin
  wl_display_dispatch_pending(display);
 end;
 wl_display_flush(display);
 result:= wl_display_get_fd(display);
end;

procedure wlc_pollfinish(const readable: boolean);
begin
 if readable then begin
  wl_display_read_events(display);
 end
 else begin
  wl_display_cancel_read(display);
 end;
 wl_display_dispatch_pending(display);
end;

procedure wlc_flush;
begin
 if display <> nil then begin
  wl_display_flush(display);
 end;
end;

end.
