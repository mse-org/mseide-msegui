procedure wlc_setmaximized(const win: twlwindow; const value: boolean);
begin
 if (win <> nil) and (win.toplevel <> nil) then begin
  if value then begin
   xdg_toplevel_set_maximized(win.toplevel);
  end
  else begin
   xdg_toplevel_unset_maximized(win.toplevel);
