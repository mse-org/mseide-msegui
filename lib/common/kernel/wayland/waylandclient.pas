//cursor

var
 curtheme: pwl_cursor_theme;
 cursurface: pointer;
 curname: string;
 curserial,enterserial: cuint32;

procedure setcursorimage(const aname: string);
var
 cur: pwl_cursor;
 img: pwl_cursor_image;
 buf: pointer;
begin
 if (wlpointer = nil) or (shm = nil) or (compositor = nil) then begin
  exit;
 end;
 if (aname = curname) and (enterserial = curserial) then begin
  exit;
 end;
 curname:= aname;
 curserial:= enterserial;
 if aname = 'none' then begin
  wl_pointer_set_cursor(wlpointer,enterserial,nil,0,0);
  exit;
 end;
 if curtheme = nil then begin
  curtheme:= wl_cursor_theme_load(nil,24,shm);
 end;
 if curtheme = nil then begin
  exit;
 end;
 cur:= wl_cursor_theme_get_cursor(curtheme,pchar(aname));
 if cur = nil then begin
  cur:= wl_cursor_theme_get_cursor(curtheme,'left_ptr');
 end;
 if (cur = nil) or (cur^.image_count = 0) then begin
  exit;
 end;
 img:= cur^.images^;
 buf:= wl_cursor_image_get_buffer(img);
 if buf = nil then begin
  exit;
 end;
 if cursurface = nil then begin
  cursurface:= wl_compositor_create_surface(compositor);
 end;
 wl_surface_attach(cursurface,buf,0,0);
 wl_surface_damage_buffer(cursurface,0,0,img^.width,img^.height);
 wl_surface_commit(cursurface);
 wl_pointer_set_cursor(wlpointer,enterserial,cursurface,img^.hotspot_x,
                                                           img^.hotspot_y);
end;

procedure applycursor(const win: twlwindow);
var
 aname: string;
begin
 if (win = nil) or (win <> pointerwin) then begin
  exit;
 end;
 case win.hoverzone of
  101: aname:= 'top_side';
  102: aname:= 'bottom_side';
  104: aname:= 'left_side';
  105: aname:= 'top_left_corner';
  106: aname:= 'bottom_left_corner';
  108: aname:= 'right_side';
  109: aname:= 'top_right_corner';
  110: aname:= 'bottom_right_corner';
  else begin
   if win.hoverzone >= 1 then begin
    aname:= 'left_ptr';
   end
   else begin
    aname:= win.cursorname;
    if aname = '' then begin
     aname:= 'left_ptr';
    end;
   end;
  end;
 end;
 setcursorimage(aname);
end;

procedure wlc_setcursor(const win: twlwindow; const aname: string);
begin
 if win <> nil then begin
  win.cursorname:= aname;
  applycursor(win);
 end;
end;

procedure updatehover(const win: twlwindow; const zone: integer);
begin
 if win.hoverzone <> zone then begin
  win.hoverzone:= zone;
  if csd(win) and win.visible then begin
   wlc_present(win);
  end;
  applycursor(win);
 end;
end;

//pointer position in surface coordinates -> client events
procedure pointerat(const win: twlwindow; const sx,sy: integer;
                                                const atime: cuint32);
var
 zone: integer;
 ev: twlevent;
begin
 zone:= hittest(win,sx,sy);
 if win.inclient and (clientbuttons > 0) then begin
  zone:= 0;                          //implicit grab while dragging
 end;
 if zone = 0 then begin
  pointerx:= sx - offx(win);
  pointery:= sy - offy(win);
  if not win.inclient then begin
   win.inclient:= true;
   ev:= newevent(wle_pointerenter,win);
   ev.x:= pointerx;
   ev.y:= pointery;
   ev.mods:= curmods;
   pushevent(ev);
  end
  else begin
   ev:= newevent(wle_pointermotion,win);
   ev.time:= atime;
   ev.x:= pointerx;
   ev.y:= pointery;
   ev.mods:= curmods;
   pushevent(ev);
  end;
  updatehover(win,-1);
 end
 else begin
  if win.inclient then begin
   win.inclient:= false;
   pushevent(newevent(wle_pointerleave,win));
  end;
  updatehover(win,zone);
 end;
end;

procedure onpenter(data: pointer; ptr: pointer; serial: cuint32;
                   surf: pointer; sx,sy: cint32); cdecl;
begin
 wlc_lastserial:= serial;
 enterserial:= serial;
 pointerwin:= wlc_windowfromsurface(surf);
 if pointerwin <> nil then begin
  pointerwin.inclient:= false;
  pointerat(pointerwin,wl_fixed_to_int(sx),wl_fixed_to_int(sy),0);
  applycursor(pointerwin);            //new serial: set the cursor again
 end;
end;

procedure onpleave(data: pointer; ptr: pointer; serial: cuint32;
                   surf: pointer); cdecl;
begin
 if pointerwin <> nil then begin
  if pointerwin.inclient then begin
   pointerwin.inclient:= false;
   pushevent(newevent(wle_pointerleave,pointerwin));
  end;
  updatehover(pointerwin,-1);
 end;
 pointerwin:= nil;
end;

procedure onpmotion(data: pointer; ptr: pointer; time: cuint32;
                   sx,sy: cint32); cdecl;
begin
 if pointerwin <> nil then begin
  pointerat(pointerwin,wl_fixed_to_int(sx),wl_fixed_to_int(sy),time);
 end;
end;

procedure onpbutton(data: pointer; ptr: pointer; serial,time,button,
                                                   state: cuint32); cdecl;
var
 ev: twlevent;
 zone: integer;
 win: twlwindow;
begin
 wlc_lastserial:= serial;
 win:= pointerwin;
 if win = nil then begin
  exit;
 end;
 if win.inclient then begin
  ev:= newevent(wle_button,win);
  ev.time:= time;
  ev.x:= pointerx;
  ev.y:= pointery;
  ev.button:= button;
  ev.pressed:= state = 1;
  ev.mods:= curmods;
  pushevent(ev);
  if state = 1 then begin
   inc(clientbuttons);
  end
  else begin
   if clientbuttons > 0 then begin
    dec(clientbuttons);
   end;
  end;
 end
 else begin                                    //decoration
  if (state = 1) and (button = BTN_LEFT) then begin
   zone:= win.hoverzone;
   if wlc_debug then begin
    writeln('decoration click zone ',zone);
    flush(system.output);
   end;
   case zone of
    1: begin
     if (win.lastclick <> 0) and (time - win.lastclick < 400) then begin
      win.lastclick:= 0;
      if win.maximized then begin
       wlc_setmaximized(win,false);
      end
      else begin
       wlc_setmaximized(win,true);
      end;
     end
     else begin
      win.lastclick:= time;
      wlc_move(win);
     end;
    end;
    2: begin
     pushevent(newevent(wle_close,win));
    end;
    3: begin
     if win.maximized then begin
      wlc_setmaximized(win,false);
     end
     else begin
      wlc_setmaximized(win,true);
     end;
    end;
    4: begin
     wlc_setminimized(win);
    end;
    else begin
     if zone >= 100 then begin
      wlc_resize(win,zone - 100);
     end;
    end;
   end;
  end;
 end;
end;

procedure onpaxis(data: pointer; ptr: pointer; time,axis: cuint32;
                                                 value: cint32); cdecl;
var
 ev: twlevent;
begin
 if (pointerwin <> nil) and pointerwin.inclient then begin
  ev:= newevent(wle_axis,pointerwin);
  ev.time:= time;
  ev.x:= pointerx;
  ev.y:= pointery;
  ev.axis:= axis;
  ev.value:= wl_fixed_to_double(value);
  ev.mods:= curmods;
  pushevent(ev);
 end;
end;

procedure onpaxisdiscrete(data: pointer; ptr: pointer; axis: cuint32;
                                                 discrete: cint32); cdecl;
var
 ev: twlevent;
begin
 if (pointerwin <> nil) and pointerwin.inclient then begin
  ev:= newevent(wle_axisdiscrete,pointerwin);
  ev.axis:= axis;
  ev.value:= discrete;
  ev.mods:= curmods;
  pushevent(ev);
 end;
end;

//keyboard

procedure onkkeymap(data: pointer; kb: pointer; format: cuint32; fd: cint32;
                                               size: cuint32); cdecl;
var
 map: pointer;
 str: pchar;
begin
 if xkbstate <> nil then begin
  xkb_state_unref(xkbstate);
  xkbstate:= nil;
 end;
 if plainstate <> nil then begin
  xkb_state_unref(plainstate);
  plainstate:= nil;
 end;
 if xkbmap <> nil then begin
  xkb_keymap_unref(xkbmap);
  xkbmap:= nil;
 end;
 if format = 1 then begin          //WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1
  map:= fpmmap(nil,size,PROT_READ,MAP_PRIVATE,fd,0);
  if map <> pointer(-1) then begin
   getmem(str,size + 1);           //own copy with certain 0 termination
   move(map^,str^,size);
   str[size]:= #0;
   fpmunmap(map,size);
   xkbmap:= xkb_keymap_new_from_string(xkbctx,str,XKB_KEYMAP_FORMAT_TEXT_V1,
                                              XKB_KEYMAP_COMPILE_NO_FLAGS);
   freemem(str);
   if xkbmap <> nil then begin
    xkbstate:= xkb_state_new(xkbmap);
    plainstate:= xkb_state_new(xkbmap);
   end;
  end;
 end;
 fpclose(fd);
end;

procedure onkenter(data: pointer; kb: pointer; serial: cuint32;
                                 surf: pointer; keys: pwl_array); cdecl;
begin
 wlc_lastserial:= serial;
 keyboardwin:= wlc_windowfromsurface(surf);
 if keyboardwin <> nil then begin
  pushevent(newevent(wle_keyboardenter,keyboardwin));
 end;
end;

procedure onkleave(data: pointer; kb: pointer; serial: cuint32;
                                 surf: pointer); cdecl;
begin
 repeatkey:= 0;
 if keyboardwin <> nil then begin
  pushevent(newevent(wle_keyboardleave,keyboardwin));
 end;
 keyboardwin:= nil;
end;

procedure pushkey(const key: cuint32; const apressed,arepeated: boolean;
                                                      const atime: cuint32);
var
 ev: twlevent;
begin
 if keyboardwin <> nil then begin
  ev:= newevent(wle_key,keyboardwin);
  ev.time:= atime;
  ev.key:= key;
  ev.pressed:= apressed;
  ev.repeated:= arepeated;
  ev.mods:= curmods;
  if xkbstate <> nil then begin
   ev.keysym:= xkb_state_key_get_one_sym(xkbstate,evdevtoxkb(key));
   if plainstate <> nil then begin
    ev.keysym0:= xkb_state_key_get_one_sym(plainstate,evdevtoxkb(key));
   end
   else begin
    ev.keysym0:= ev.keysym;
   end;
   if apressed then begin
    ev.utf8:= keyutf8(xkbstate,key);
   end;
  end;
  pushevent(ev);
 end;
end;

procedure onkkey(data: pointer; kb: pointer; serial,time,key,
                                              state: cuint32); cdecl;
begin
 wlc_lastserial:= serial;
 pushkey(key,state = 1,false,time);
 if state = 1 then begin
  if (xkbmap <> nil) and (repeatrate > 0) and
          (xkb_keymap_key_repeats(xkbmap,evdevtoxkb(key)) <> 0) then begin
   repeatkey:= key;
   repeatdue:= GetTickCount64 + qword(repeatdelay);
  end;
 end
 else begin
  if key = repeatkey then begin
   repeatkey:= 0;
  end;
 end;
end;

procedure onkmodifiers(data: pointer; kb: pointer; serial,depressed,latched,
                                 locked,group: cuint32); cdecl;
begin
 if xkbstate <> nil then begin
  xkb_state_update_mask(xkbstate,depressed,latched,locked,0,0,group);
 end;
end;

procedure onkrepeatinfo(data: pointer; kb: pointer; rate,delay: cint32); cdecl;
begin
 repeatrate:= rate;
 repeatdelay:= delay;
end;

function wlc_timeout(const maxms: integer): integer;
var
 now: qword;
begin
 result:= maxms;
 if repeatkey <> 0 then begin
  now:= GetTickCount64;
  if repeatdue <= now then begin
   result:= 0;
  end
  else begin
   if repeatdue - now < qword(result) then begin
    result:= integer(repeatdue - now);
   end;
  end;
 end;
end;

procedure wlc_timers;
var
 now: qword;
begin
 if (repeatkey <> 0) and (repeatrate > 0) then begin
  now:= GetTickCount64;
  while (repeatkey <> 0) and (repeatdue <= now) do begin
   pushkey(repeatkey,true,true,cuint32(now));
   repeatdue:= repeatdue + qword(1000 div repeatrate);
  end;
 end;
end;

